# 다시 만나 백엔드 환경변수. 설정 방법은 docs/development.md 를 참고한다.
# 실제 값은 .env(로컬, Git 제외) 또는 Render 서비스 Environment 에 넣는다.

# local: 규칙 기반 + SQLite 사용 가능 / live: OpenAI + Supabase 필수
APP_MODE=local
STORAGE_BACKEND=sqlite
SQLITE_PATH=.data/meet-again.db

SUPABASE_URL=https://yaywavgjaquftvekuvsb.supabase.co
SUPABASE_SCHEMA=aio-03-p2-team1-demo
# 서버 전용. legacy service_role JWT. 지정 스키마의 documents 테이블과 Data API 설정이 필요하다.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# LangSmith 추적(선택). true로 켜려면 발급한 API 키를 설정한다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dasimanna
# 셀프 호스팅 등 별도 endpoint를 쓸 때만 지정한다.
LANGSMITH_ENDPOINT=

# 공공데이터포털 구조동물 API 키. 키 끝에 _Decoding 같은 표시를 붙이지 않는다.
# 별칭 ANIMAL_API_SERVICE_KEY 도 읽는다(둘 다 있으면 ANIMAL_API_KEY 우선). 하나만 설정하자.
ANIMAL_API_KEY=
ANIMAL_API_BASE_URL=https://apis.data.go.kr/1543061/abandonmentPublicService_v2

# 카카오 REST API 키(백엔드 전용, 보호센터 주소 → 좌표)
KAKAO_REST_API_KEY=

# Discord DM 알림(아직 발송 기능 미구현)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# 정확한 origin 목록(쉼표 구분, 끝 / 없이). 와일드카드 금지.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 로그인 세션 저장소. 로컬은 compose.yaml 의 Redis, 운영은 Render Key Value 의 내부 연결 URL.
REDIS_URL=redis://127.0.0.1:6380/0
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SAMESITE=lax
# 미설정 시 local=false, live=true. 로컬 HTTP 에서 live 로 실행할 때만 false 를 명시한다.
# AUTH_COOKIE_SECURE=

MAX_SEARCH_PAGES=3
MAX_REFLECTIONS=2
MAX_TOOL_CALLS=30
REQUEST_TIMEOUT_SECONDS=60
